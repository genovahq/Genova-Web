# Copy to .env.local for local dev, and add both to Vercel →
# Project Settings → Environment Variables (Production + Preview).
#
# Neither of these is prefixed NEXT_PUBLIC_, which is what keeps them
# server-only. Never add that prefix — it would ship them to the browser and
# undo the whole point of the /api/lead proxy.

# The real n8n production webhook. Only app/api/lead/route.ts reads this.
N8N_LEAD_WEBHOOK_URL=https://genovahq.app.n8n.cloud/webhook/genova-web-lead

# Shared secret sent as the x-genova-signature header and verified by the
# "Verify Signature" node in the n8n workflow. Must match on both sides.
# Rotate by generating a new one, updating n8n first, then Vercel:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LEAD_SHARED_SECRET=replace-me
